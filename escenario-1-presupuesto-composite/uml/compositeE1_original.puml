@startuml
title Escenario 1 - Presupuesto institucional con Composite

skinparam classAttributeIconSize 0
skinparam linetype ortho

abstract class ElementoPresupuestario <<Component>> {
    - codigo : String
    - descripcion : String
    --
    + getCodigo() : String
    + getDescripcion() : String
    {abstract} + calcularValorTotal() : BigDecimal
    {abstract} + mostrarEstructura(nivel : int) : String
}

class PartidaPresupuestaria <<Leaf>> {
    - valorAsignado : BigDecimal
    --
    + calcularValorTotal() : BigDecimal
    + mostrarEstructura(nivel : int) : String
}

class GrupoPresupuestario <<Composite>> {
    - elementos : List<ElementoPresupuestario>
    --
    + calcularValorTotal() : BigDecimal
    + mostrarEstructura(nivel : int) : String
    + agregar(e : ElementoPresupuestario) : void
    + eliminar(e : ElementoPresupuestario) : void
    + getElementos() : List<ElementoPresupuestario>
}

class ConsultaPresupuesto <<Client>> {
    + generarReporte(elemento : ElementoPresupuestario) : String
}

ElementoPresupuestario <|-- PartidaPresupuestaria
ElementoPresupuestario <|-- GrupoPresupuestario
' atributo GrupoPresupuestario.elementos: relación recursiva que forma el árbol
GrupoPresupuestario "1" *--> "0..*" ElementoPresupuestario : elementos
' parámetro de generarReporte: no hay atributo, es una dependencia
ConsultaPresupuesto ..> ElementoPresupuestario : usa

note right of GrupoPresupuestario
  calcularValorTotal() = suma de calcularValorTotal()
  de cada elemento, sean partidas u otros grupos.
  Ej.: Tecnologías de la Información
  contiene el grupo Infraestructura.
end note

note right of PartidaPresupuestaria
  calcularValorTotal() = valorAsignado
end note

legend right
  <<Component>> abstracción común de partidas y grupos
  <<Leaf>> partida individual, sin hijos
  <<Composite>> grupo que guarda elementos y delega en ellos
  <<Client>> trata igual partidas y grupos
endlegend

@enduml
