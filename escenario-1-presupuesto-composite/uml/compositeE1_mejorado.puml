@startuml
title Escenario 1 - Presupuesto institucional con Composite (version mejorada)

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam dpi 200
skinparam defaultFontSize 12

abstract class ElementoPresupuestario <<Component>> {
    - codigo : String
    - descripcion : String
    --
    # ElementoPresupuestario(codigo : String, descripcion : String)
    + getCodigo() : String
    + getDescripcion() : String
    {abstract} + calcularValorTotal() : BigDecimal
    {abstract} + mostrarEstructura(nivel : int) : String
    # formatearLinea(nivel : int) : String
    - {static} validarTexto(valor : String, campo : String) : String
}

class PartidaPresupuestaria <<Leaf>> {
    - valorAsignado : BigDecimal
    --
    + PartidaPresupuestaria(codigo : String, descripcion : String, valorAsignado : BigDecimal)
    + getValorAsignado() : BigDecimal
    + calcularValorTotal() : BigDecimal
    + mostrarEstructura(nivel : int) : String
}

class GrupoPresupuestario <<Composite>> {
    - elementos : List<ElementoPresupuestario>
    --
    + GrupoPresupuestario(codigo : String, descripcion : String)
    + calcularValorTotal() : BigDecimal
    + mostrarEstructura(nivel : int) : String
    + agregar(elemento : ElementoPresupuestario) : void
    + eliminar(elemento : ElementoPresupuestario) : void
    + getElementos() : List<ElementoPresupuestario>
    - contieneDescendiente(elemento : ElementoPresupuestario) : boolean
}

class ConsultaPresupuesto <<Client>> {
    + generarReporte(elemento : ElementoPresupuestario) : String
}

ElementoPresupuestario <|-- PartidaPresupuestaria
ElementoPresupuestario <|-- GrupoPresupuestario
' atributo GrupoPresupuestario.elementos: relacion recursiva que forma el arbol
GrupoPresupuestario "1" *--> "0..*" ElementoPresupuestario : elementos
' parametro de generarReporte: no hay atributo, es una dependencia
ConsultaPresupuesto ..> ElementoPresupuestario : usa

note top of ElementoPresupuestario
  Validaciones del constructor:
  codigo y descripcion no nulos ni vacios.
  mostrarEstructura(nivel): nivel >= 0,
  sangria de 2 espacios por nivel.
end note

note right of PartidaPresupuestaria
  calcularValorTotal() = valorAsignado
  valorAsignado no nulo y >= 0
end note

note right of GrupoPresupuestario
  calcularValorTotal() = suma recursiva de
  calcularValorTotal() de cada elemento (BigDecimal).
  Grupo vacio: total 0.
  getElementos(): vista no modificable.
  agregar(e) rechaza: e nulo, e == this,
  e que ya esta en el arbol del grupo y
  un grupo que contiene a this (ciclo).
  eliminar(e) rechaza e que no es hijo directo.
  agregar/eliminar solo en el Composite
  (variante segura): una partida no tiene hijos.
  Composicion: cada elemento pertenece a un
  unico grupo y existe solo como parte del presupuesto.
end note

legend right
  <<Component>> abstraccion comun de partidas y grupos
  <<Leaf>> partida individual, sin hijos
  <<Composite>> grupo que guarda elementos y delega en ellos
  <<Client>> trata igual partidas y grupos
endlegend

@enduml
